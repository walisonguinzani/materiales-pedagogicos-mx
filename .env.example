# Zenith Payments API (solo backend: configúralas en Vercel → Settings → Environment Variables)
ZENITH_PUBLIC_KEY=
ZENITH_SECRET_KEY=
ZENITH_WEBHOOK_SECRET=
ZENITH_ENVIRONMENT=production

# Base de datos para pedidos e idempotencia (Vercel KV / Upstash Redis)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# URL pública del sitio (para returnUrl y cancelUrl). Ej: https://tudominio.com
SITE_URL=

# Enlace del Grupo VIP que se muestra SOLO cuando el webhook confirma el pago.
# Si lo dejas vacío se usa el enlace que ya está en api/_lib/pricing.js.
VIP_GROUP_URL=

# Opcional: tu automatización (ZapData, Make…) recibe cada pedido pagado
FULFILLMENT_WEBHOOK_URL=

# Meta (Facebook) API de Conversiones — opcional. Sin META_PIXEL_ID no se envían eventos.
# Pon el mismo ID en <meta name="meta-pixel" content="..."> de index.html, checkout.html y gracias.html.
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
